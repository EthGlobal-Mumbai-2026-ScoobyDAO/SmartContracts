# Copy to .env and fill only locally. .env is ignored by Git.
# DEPLOYER_PRIVATE_KEY must be a 0x-prefixed 32-byte hex value for forge scripts.
DEPLOYER_PRIVATE_KEY=
ETH_SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
ARB_SEPOLIA_RPC_URL=https://arbitrum-sepolia-rpc.publicnode.com
# One Etherscan V2 key verifies contracts on both Ethereum and Arbitrum Sepolia.
ETHERSCAN_API_KEY=
SEPOLIA_CCIP_ROUTER=0x0BF3dE8c5D3e8A2B34D2BEeB17ABfCeBaf363A59
ARBITRUM_SEPOLIA_CCIP_ROUTER=0x2a9C5afB0d0e4BAb2BCdaE109EC4b0c4Be15a165
ARBITRUM_SEPOLIA_CHAIN_SELECTOR=3478487238524512106
ETHEREUM_SEPOLIA_CHAIN_SELECTOR=16015286601757825753
SEPOLIA_V4_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
SEPOLIA_REPORT_REGISTRY=
SEPOLIA_V2_VAULT=
SEPOLIA_V2_CCIP_RECEIVER=
ARBITRUM_V2_CCIP_SENDER=
SEPOLIA_V2_HOOK_FACTORY=
SEPOLIA_V2_HOOK=
SEPOLIA_V2_SWAP_ROUTER=
SEPOLIA_V2_ATOMIC_ROUTER=
V2_REPORT_ID=
V2_SOURCE_CUTOFF=
V2_CCIP_GAS_LIMIT=1500000
# Change this for each subsequent message from the same source wallet.
V2_CCIP_NONCE=1
V2_CCIP_AMOUNT=5000000
SEPOLIA_DEMO_USD=
ARBITRUM_DEMO_USD=
SEPOLIA_DEMO_POOL=
ARBITRUM_DEMO_POOL=
SEPOLIA_RMN_PROXY=0xba3f6251de62dED61Ff98590cB2fDf6871FbB991
ARBITRUM_RMN_PROXY=0x9527E2d01A3064ef6b50c1Da1C0cC523803BCFF2
SEPOLIA_TOKEN_ADMIN_REGISTRY=0x95F29FEE11c5C55d26cCcf1DB6772DE953B37B82
ARBITRUM_TOKEN_ADMIN_REGISTRY=0x8126bE56454B628a88C17849B9ED99dd5a11Bd2f
SEPOLIA_REGISTRY_MODULE=0xa3c796d480638d7476792230da1E2ADa86e031b0
ARBITRUM_REGISTRY_MODULE=0xaD417c0611dBD225471D31F056b8B6beC1CBC153
